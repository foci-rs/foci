set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() / ".."
repos := "shared/foci-tmc4671 shared/foci-klipper shared/foci-usb-stm32 shared/foci-firmware boards/openffboard-fw boards/ouroboros-fw"
pinned := "ankyra shared/foci-tmc4671 shared/foci-klipper shared/foci-usb-stm32 shared/foci-firmware boards/openffboard-fw boards/ouroboros-fw host/klipper-foci host/foci-trace"

default:
    @just --justfile {{ justfile() }} --list

# level is major, minor or patch. Previews by default; execute=true makes the commits and tags. Never pushes.
release level execute="false":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"

    if ! [[ "{{ level }}" =~ ^(major|minor|patch|[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)$ ]]; then
        echo "error: level must be major, minor, patch or a SemVer version such as 0.4.0-rc.1" >&2; exit 1
    fi

    for repo in . {{ pinned }}; do
        if [ "$(git -C "$repo" branch --show-current)" != main ]; then
            echo "error: $repo is not on main" >&2; exit 1
        fi
    done
    for repo in . {{ repos }}; do
        dirty="$(git -C "$repo" status --porcelain --untracked-files=no | grep -v -e '^ M \(ankyra\|boards\|shared\|host\)' -e '^ M Cargo.lock$' || true)"
        if [ -n "$dirty" ]; then
            echo "error: $repo has uncommitted changes:" >&2; echo "$dirty" >&2; exit 1
        fi
    done

    if [ "{{ execute }}" != true ]; then
        cargo release version {{ level }} --workspace
        git checkout -- Cargo.lock
        echo "klipper-foci will be tagged with the same version"
        echo "preview only; re-run with execute=true to apply"
        exit 0
    fi

    cargo release version {{ level }} --workspace --execute --no-confirm
    version="$(cargo metadata --no-deps --format-version 1 --offline \
        | python3 -c 'import json,sys; print(next(p["version"] for p in json.load(sys.stdin)["packages"] if p["name"] == "foci-firmware"))')"

    for repo in . host/klipper-foci; do
        if git -C "$repo" rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
            git checkout -- Cargo.toml Cargo.lock
            for crate_repo in {{ repos }}; do git -C "$crate_repo" checkout -- .; done
            echo "error: $repo already has tag v$version; nothing was committed" >&2; exit 1
        fi
    done

    perl -0pi -e 's/(\[workspace\.package\]\n)(version = "[^"]*"\n)?/$1version = "'"$version"'"\n/' Cargo.toml
    cargo metadata --format-version 1 --offline >/dev/null

    for repo in {{ repos }}; do
        if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; then
            git -C "$repo" add -u
            git -C "$repo" commit -q -m "chore(release): Bump $(basename "$repo") to $version" \
                -m "Bump the crate versions in lockstep with the FOCI workspace release."
        fi
    done

    git add Cargo.toml Cargo.lock {{ pinned }}
    git commit -q -m "chore(release): Bump the workspace to $version" \
        -m "Record the $version state: the submodule pins, Cargo.lock and the workspace version are brought to match that release."
    git tag -a "v$version" -m "v$version"

    git -C host/klipper-foci tag -a "v$version" -m "v$version"

    echo "released v$version (foci and klipper-foci) locally"
